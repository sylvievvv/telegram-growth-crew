# The owner's EXISTING bot: only used to send approved posts
POSTING_BOT_TOKEN=
# A NEW bot from @BotFather: makes ad links and counts joins (admin right: Invite users via link)
TRACKING_BOT_TOKEN=
# The channel: @channelname or its -100… id
CHANNEL_ID=@your_channel
# Long random string (openssl rand -hex 24). The connector URL is https://your-domain/<this>/mcp
CONNECTOR_SECRET=
PORT=8080
DB_PATH=connector.db
# Welcome message for new members (Claude can change it later with the welcome_message tool).
# %username% = their @username (or first name), %firstname% = their first name
WELCOME_TEXT=Welcome %username%! 👋 Glad you're here. Start with our pinned post.
# Ad links ask to join; the bot approves at once and sends the welcome DM. Set to no to switch off.
WELCOME_ON_AD_LINKS=yes
# Optional: your discussion group (@name or -100… id). New members are greeted there by name.
WELCOME_GROUP_ID=
