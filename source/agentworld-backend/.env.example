# --- Telegram: the NEW Agent World bot (from @BotFather), not the existing posting bot
TELEGRAM_BOT_TOKEN=
# Send /myid to the bot, then paste the number here and restart
OWNER_CHAT_ID=

# --- TGStat API (https://api.tgstat.ru)
TGSTAT_TOKEN=
# Codes from: python tgstat.py categories / languages / countries
TGSTAT_CATEGORY=
TGSTAT_LANGUAGE=
TGSTAT_COUNTRY=

# --- Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- About the owner's channel (used in messages to admins)
MY_CHANNEL=@your_channel
MY_CHANNEL_PITCH=a crypto education channel: explainers, polls, no trading signals
MY_NAME=

# --- Which channels to keep
MIN_SUBSCRIBERS=3000
MAX_SUBSCRIBERS=300000

DB_PATH=agentworld.db

# Welcome message for new members. %username% = @username (or first name), %firstname% = first name
# The channel the /adlink links are for (defaults to MY_CHANNEL)
CHANNEL_ID=
WELCOME_TEXT=Welcome %username%! 👋 Glad you're here. Start with our pinned post.
# Optional: discussion group (@name or -100… id); new members are greeted there by name
WELCOME_GROUP_ID=
